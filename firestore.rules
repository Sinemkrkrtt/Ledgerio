// Ledgerio — Firestore Security Rules
// Bu kuralları Firebase Console > Firestore Database > Rules sekmesine yapıştırıp Publish bas.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Her kullanıcı sadece kendi dökümanına erişebilir
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // İşlemler — userId alanı kullanıcının uid'i ile eşleşmeli
    match /transactions/{txId} {
      allow read:   if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Sabit giderler
    match /recurring_expenses/{expId} {
      allow read:   if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Varlıklar (kasa)
    match /assets/{assetId} {
      allow read:   if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Hedefler
    match /goals/{goalId} {
      allow read:   if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
